VANTAGE_ENVIRONMENT=production
VANTAGE_ADAPTER=openstack
VANTAGE_STORE_BACKEND=redis
VANTAGE_REDIS_URL=redis://redis.example.internal:6379/0
VANTAGE_REDIS_KEY_PREFIX=vantage
VANTAGE_OS_AUTH_URL=https://keystone.example/v3
VANTAGE_OS_INTERFACE=internal
VANTAGE_OS_REGION=RegionOne
VANTAGE_COOKIE_SECURE=true
VANTAGE_SESSION_TTL_SECONDS=3600
VANTAGE_OS_TIMEOUT_SECONDS=15
VANTAGE_IDENTITY_SOURCE_TIMEOUT_SECONDS=2
VANTAGE_SCOPE_SOURCE_TIMEOUT_SECONDS=1
VANTAGE_QUOTA_SOURCE_TIMEOUT_SECONDS=3
VANTAGE_INSTANCE_SOURCE_TIMEOUT_SECONDS=3
VANTAGE_PROVISIONING_SOURCE_TIMEOUT_SECONDS=3
VANTAGE_OPENSTACK_SDK_THREAD_CAPACITY=8
VANTAGE_OPENSTACK_CONNECTION_CACHE_SIZE=256
VANTAGE_QUOTA_CACHE_TTL_SECONDS=10
VANTAGE_SHUTDOWN_GRACE_SECONDS=10
VANTAGE_METRICS_ENABLED=true
